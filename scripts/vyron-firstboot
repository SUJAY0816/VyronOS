#!/usr/bin/env bash
# ==============================================================================
# VYRON Micro-OS - Hardware Console & First Boot Sequence
# ==============================================================================
set -euo pipefail

clear

echo "================================================================================"
echo "  VYRON Micro-OS 1.0 LTS"
echo "  Hardware Console Initialization"
echo "================================================================================"

# Hardware Probes
ARCH=$(uname -m)
KERNEL=$(uname -r)
CORES=$(nproc 2>/dev/null || echo "Unknown")
MEM_TOTAL=$(awk '/MemTotal/ {printf "%.1f GB", $2/1024/1024}' /proc/meminfo 2>/dev/null || echo "Unknown")
MEM_AVAIL=$(awk '/MemAvailable/ {printf "%.1f GB", $2/1024/1024}' /proc/meminfo 2>/dev/null || echo "Unknown")
IP_ADDR=$(ip -4 addr show 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | grep -v '127.0.0.1' | head -n1 || echo "DHCP Pending")
UPTIME=$(uptime -p 2>/dev/null || echo "0 min")

printf "  %-24s: %s\n" "CPU Architecture" "${ARCH} (${CORES} Cores Online)"
printf "  %-24s: %s (Available: %s)\n" "Physical Memory" "${MEM_TOTAL}" "${MEM_AVAIL}"
printf "  %-24s: %s\n" "Kernel Release" "${KERNEL}"
printf "  %-24s: %s\n" "Network Address" "${IP_ADDR}"
printf "  %-24s: %s\n" "Storage Layer" "SquashFS (Read-Only) + OverlayFS (RAM Upperdir)"
printf "  %-24s: %s\n" "In-Built Package Engine" "/usr/bin/aptitude (aliased to apt)"
echo "--------------------------------------------------------------------------------"
echo "  Available Commands:"
echo "    file:  cd pwd ls tree touch mkdir rm cp mv stat du"
echo "    text:  cat grep head tail wc echo"
echo "    sys:   ps top kill uptime free df uname whoami hostname env which dmesg"
echo "    net:   ping curl wget ip ifconfig netstat nslookup traceroute"
echo "    mgmt:  aptitude (apt), clear, reboot, demo"
echo "================================================================================"
echo ""

read -rp "Press Enter to start interactive shell..." _
exec /bin/bash -l
